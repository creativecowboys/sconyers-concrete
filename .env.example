# Resend — powers the contact / estimate-request forms.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Where leads are delivered. Defaults to chip.sconyers@sconyersconcrete.com.
CONTACT_TO_EMAIL=

# The From address. The domain MUST be verified in Resend or sends will fail.
# Defaults to "Sconyers Concrete Website <noreply@sconyersconcrete.com>".
CONTACT_FROM_EMAIL=

# ── STAFF ADMIN (/admin) ────────────────────────────────────────────────────
# Supabase powers auth, the Postgres database and file storage for the admin.
# Both values are on the Supabase dashboard: Project Settings → API.
# The anon key is safe in the browser — Row Level Security is what protects the
# data, and supabase/schema.sql sets it up. There is deliberately no
# service-role key in this project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Who gets emailed when the field flags a change order. Comma-separated.
# Falls back to CONTACT_TO_EMAIL if unset. Reuses RESEND_API_KEY above.
CHANGE_ORDER_TO_EMAILS=
